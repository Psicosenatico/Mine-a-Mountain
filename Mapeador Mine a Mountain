    makeCurrentValueMapper(money, "Segundos congelado", "OPTION", "SellFreezeSecs", "MONEY / FREEZE SECONDS")

    local favorite = section(scroll, "Auto Favorite")
    makeToggleMapper(favorite, "Auto Favorite", "AutoFavorite", "FAVORITE / AUTO")
    makeToggleMapper(favorite, "Favoritar por raridade", "AutoFavRarity", "FAVORITE / RARITY")
    makeCurrentValueMapper(favorite, "Luck mínimo", "OPTION", "AutoFavoriteLuck", "FAVORITE / MIN LUCK")
    makeCurrentValueMapper(favorite, "Valor mínimo", "OPTION", "AutoFavoriteValue", "FAVORITE / MIN VALUE")
    makeOptionMapper(favorite, "Raridades", "FavRaritySelect", "FAVORITE / RARITY SELECT", true)

    local dupe = section(scroll, "Dupe / Duplicação")
    makeToggleMapper(dupe, "Player Dupe Nuker", "PlayerDupeNuker", "DUPE / PLAYER NUKER")
    makeToggleMapper(dupe, "Dupe Swing", "DupeSwing", "DUPE / SWING")
    makeToggleMapper(dupe, "Visualizar zona do Dupe", "DupeZnVis", "DUPE / ZONE VISUAL")

    local placement = section(scroll, "Placement / Cristais / Runas")
    makeToggleMapper(placement, "Auto Place Crystals", "AutoPlaceCrystals", "PLACE / CRYSTALS")
    makeToggleMapper(placement, "Auto Place Best", "AutoPlaceCrystalsBest", "PLACE / BEST")
    makeToggleMapper(placement, "Auto Place Runes", "AutoPlaceRunes", "PLACE / RUNES")
    makeToggleMapper(placement, "Mostrar grade", "ShowPlacementGrid", "PLACE / GRID")
    makeToggleMapper(placement, "Instant Plot Take", "InstantPlotTake", "PLACE / INSTANT TAKE")
    makeOptionMapper(placement, "Prioridade", "PlacePriorityMode", "PLACE / PRIORITY", false)
    makeOptionMapper(placement, "Prioridade Best", "PlaceBestPriorityMode", "PLACE / BEST PRIORITY", false)
    makeCurrentValueMapper(placement, "Intervalo", "OPTION", "PlaceInterval", "PLACE / INTERVAL")
    makeCurrentValueMapper(placement, "Luck mínimo", "OPTION", "PlaceMinLuck", "PLACE / MIN LUCK")
    makeCurrentValueMapper(placement, "Dinheiro mínimo", "OPTION", "PlaceMinMoney", "PLACE / MIN MONEY")
