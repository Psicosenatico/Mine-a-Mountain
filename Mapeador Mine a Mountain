local function stamp() return string.format("%.3f",os.clock()) end

local function sensitive(s)
    s=string.lower(tostring(s or ""))
    return s:find("premium",1,true) or s:find("license",1,true)
        or s:find("authorization",1,true) or s:find("bearer ",1,true)
        or s:find("session",1,true) or s:find("token",1,true)
        or s:find("key=",1,true)
end

local function clean(s)
    s=tostring(s or "")
    if sensitive(s) then return "<REDACTED_SENSITIVE_STRING>" end
    if #s>180 then return string.format("<LONG_STRING len=%d prefix=%q>",#s,s:sub(1,60)) end
    return s
end

local function full(inst)
    local ok,r=pcall(function()return inst:GetFullName()end)
    return ok and r or tostring(inst)
end

local function ser(v,depth,seen)
    depth=depth or 0
    seen=seen or {}
    if depth>3 then return "<max-depth>" end
    local t=typeof(v)
    if t=="nil" then return "nil"
    elseif t=="boolean" or t=="number" then return tostring(v)
    elseif t=="string" then return string.format("%q",clean(v))
    elseif t=="Instance" then
        return string.format("<%s %s | %s>",v.ClassName,clean(v.Name),clean(full(v)))
    elseif t=="Vector3" then return string.format("Vector3(%.3f,%.3f,%.3f)",v.X,v.Y,v.Z)
    elseif t=="Vector2" then return string.format("Vector2(%.3f,%.3f)",v.X,v.Y)
    elseif t=="CFrame" then
        local c={v:GetComponents()}
        for i=1,#c do c[i]=string.format("%.4f",c[i]) end
        return "CFrame("..table.concat(c,",")..")"
    elseif t=="Color3" then return string.format("Color3(%.3f,%.3f,%.3f)",v.R,v.G,v.B)
    elseif t=="EnumItem" then return tostring(v)
    elseif t=="function" then return "<function>"
    elseif t=="table" then
        if seen[v] then return "<cycle>" end
        seen[v]=true
        local out,n={},0
        for k,x in pairs(v) do
            n+=1
            if n>24 then out[#out+1]="...";break end
            out[#out+1]="["..ser(k,depth+1,seen).."]="..ser(x,depth+1,seen)
        end
        seen[v]=nil
        return "{"..table.concat(out,", ").."}"
    end
    return "<"..t..":"..clean(tostring(v))..">"
end

local function args(...)
    local p=table.pack(...)
    local out={}
    for i=1,p.n do out[i]=ser(p[i]) end
    return table.concat(out,", ")
end

local function mark(name)
