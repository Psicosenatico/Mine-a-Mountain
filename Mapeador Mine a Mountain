local visitedFunctions = setmetatable({}, { __mode = "k" })

local function dumpFunctionDeep(label, fn, depth)
    if type(fn) ~= "function" then return end
    depth = depth or 0
    if depth > 2 or visitedFunctions[fn] then return end
    visitedFunctions[fn] = true

    state.internalFunctions += 1
    push("")
    push(string.format("[FUNCTION][depth=%d] %s", depth, clean(label)))

    if type(getinfoFn) == "function" then
        pcall(function()
            local info = getinfoFn(fn)
            if type(info) == "table" then
                push("  info=" .. ser({
                    source = info.source or info.short_src,
                    name = info.name,
                    linedefined = info.linedefined,
                    what = info.what,
                    nups = info.nups,
                }))
            end
        end)
    elseif debug and debug.info then
        pcall(function()
            push("  debug.info=" .. tostring(debug.info(fn, "sln")))
        end)
    end

    if type(getconstantsFn) == "function" then
        local ok, constants = pcall(getconstantsFn, fn)
        if ok and type(constants) == "table" then
            local out = {}
            for i, v in pairs(constants) do
                if #out >= 180 then
                    out[#out + 1] = "..."
                    break
                end
                if type(v) ~= "string" or not sensitive(v) then
                    out[#out + 1] = tostring(i) .. "=" .. ser(v)
                else
                    out[#out + 1] = tostring(i) .. "=<REDACTED>"
                end
            end
            push("  constants=" .. table.concat(out, " | "))
        end
    end

    if type(getupvaluesFn) == "function" then
        local ok, ups = pcall(getupvaluesFn, fn)
        if ok and type(ups) == "table" then
            local summary = {}
            for i, v in pairs(ups) do
                if #summary >= 90 then
                    summary[#summary + 1] = "..."
                    break
                end
                summary[#summary + 1] = tostring(i) .. "=" .. ser(v)
            end
            push("  upvalues=" .. table.concat(summary, " | "))

            if depth < 2 then
                for i, v in pairs(ups) do
                    if type(v) == "function" then
                        dumpFunctionDeep(label .. ".upvalue[" .. tostring(i) .. "]", v, depth + 1)
                    elseif type(v) == "table" then
                        local functionHits = 0
                        for k, x in pairs(v) do
                            if type(x) == "function" then
                                functionHits += 1
                                dumpFunctionDeep(
                                    label .. ".upvalue[" .. tostring(i) .. "]." .. tostring(k),
                                    x,
                                    depth + 1
                                )
                                if functionHits >= 12 then break end
                            end
                        end
                    end
                end
            end
        end
    end

    if type(getprotosFn) == "function" and depth < 2 then
        local ok, protos = pcall(getprotosFn, fn)
        if ok and type(protos) == "table" then
            push("  protos=" .. tostring(#protos))
            for i, proto in ipairs(protos) do
                if i > 20 then break end
                if type(proto) == "function" then
                    dumpFunctionDeep(label .. ".proto[" .. i .. "]", proto, depth + 1)
                end
            end
        end
    end
end

local function inspectControl(kind, key, force)
    local token = kind .. ":" .. key
    if state.inspectedControls[token] and not force then
        push("[CONTROL] " .. token .. " ja inspecionado nesta sessao.")
        return
    end

    local obj = getControl(kind, key)
    push("")
    push("---- CONTROL BINDING " .. token .. " [" .. stamp() .. "] ----")

    if type(obj) ~= "table" then
        push("<controle ainda nao encontrado>")
        return
    end

    state.inspectedControls[token] = true
    state.callbackCount += 1

    local fields = {
        "Type", "Text", "Value", "Values", "Multi", "AllowNull",
        "Default", "Min", "Max", "Rounding", "Suffix",
        "Callback", "Changed", "SetValue", "SetValues",
    }
    for _, field in ipairs(fields) do
        local ok, value = pcall(function() return obj[field] end)
        if ok and value ~= nil then
            push("  " .. field .. "=" .. ser(value))
        end
    end

    local callback, changed
    pcall(function() callback = obj.Callback end)
    pcall(function() changed = obj.Changed end)

    if type(callback) == "function" then
        dumpFunctionDeep(token .. ".Callback", callback, 0)
    end
    if type(changed) == "function" and changed ~= callback then
        dumpFunctionDeep(token .. ".Changed", changed, 0)
    end
end

local function setToggleValue(key, value)
    local obj = getControl("TOGGLE", key)
    if type(obj) ~= "table" then return false, "toggle nao encontrado" end
    if type(obj.SetValue) ~= "function" then return false, "SetValue indisponivel" end
    local ok, err = pcall(function() obj:SetValue(value and true or false) end)
    return ok, err
end

local function setOptionValue(key, value, singleForMulti)
    local obj = getControl("OPTION", key)
    if type(obj) ~= "table" then return false, "option nao encontrada" end
    if type(obj.SetValue) ~= "function" then return false, "SetValue indisponivel" end

    local multi = false
    pcall(function() multi = obj.Multi == true end)

    local send = value
    if multi and singleForMulti then
        send = { [tostring(value)] = true }
    end

    local ok, err = pcall(function() obj:SetValue(send) end)
    return ok, err
end

local function targetControlSnapshot(kind, key)
    return {
        { kind, key }
    }
end

task.spawn(function()
    while not state.destroyed do
        if state.active then
            for _, kind in ipairs({ "TOGGLE", "OPTION" }) do
                local map = getControlMap(kind)
                if type(map) == "table" then
                    for key, obj in pairs(map) do
                        local token = kind .. ":" .. tostring(key)
                        local current = normalizeValueForDiff(readControlValue(obj))
                        local previous = state.knownControlValues[token]

                        if previous == nil then
                            state.knownControlValues[token] = current
                        elseif current ~= previous then
                            state.controlChangeCount += 1
                            push(string.format(
                                "[CONTROL_CHANGE %05d][%s][M%03d:%s] %s %s | %s -> %s",
                                state.controlChangeCount,
                                stamp(),
                                state.markerId,
                                clean(state.marker),
                                kind,
                                clean(key),
                                previous,
                                current
                            ))
                            state.knownControlValues[token] = current

                            if not state.inspectedControls[token] then
                                pcall(inspectControl, kind, tostring(key), false)
                            end
                        end
                    end
                end
            end
        end
        task.wait(0.16)
    end
end)

