local function scanRemotes()
    push("")
    push("---- REMOTES VISIVEIS EM ReplicatedStorage ----")
    local count = 0
    for _, inst in ipairs(RS:GetDescendants()) do
        if inst:IsA("RemoteEvent") or inst:IsA("RemoteFunction") then
            count += 1
            push(string.format("%03d | %s | %s", count, inst.ClassName, clean(full(inst))))
            if count >= 700 then break end
        end
    end
end

local function inspectInternals()
    if state.inspecting then return end
    state.inspecting = true
    table.clear(visitedFunctions)
    push("")
    push("################################################################")
    push("INSPECAO DETALHADA DE BINDINGS [" .. stamp() .. "]")
    push("################################################################")
    snapshotControls("TODOS OS CONTROLES", nil)
    pcall(scanRemotes)

    push("")
    push("---- CALLBACKS DOS CONTROLES GUIADOS ----")
    for i, spec in ipairs(GUIDED_CONTROLS) do
        if i % 8 == 0 then task.wait() end
        pcall(inspectControl, spec[1], spec[2], true)
    end

    if type(getgcFn) ~= "function" then
        push("getgc indisponivel.")
        state.inspecting = false
        return
    end

    local ok, objects = pcall(getgcFn, true)
    if not ok or type(objects) ~= "table" then
        push("getgc(true) falhou.")
        state.inspecting = false
        return
    end

    push("")
    push("---- TABELAS CANDIDATAS (1+ HIT) ----")
    local tableCount = 0
    for i, obj in ipairs(objects) do
        if i % 350 == 0 then task.wait() end
        if type(obj) == "table" then
            local hits = {}
            for _, key in ipairs(TARGET_KEYS) do
                if rawget(obj, key) ~= nil then hits[#hits + 1] = key end
            end
            if #hits >= 1 then
                tableCount += 1
                state.internalTables += 1
                push(string.format("[TABLE %03d] gc=%d hits=%s", tableCount, i, table.concat(hits, ", ")))
                for _, key in ipairs(hits) do
                    local value = rawget(obj, key)
                    push("  " .. key .. "=" .. ser(value))
                    if type(value) == "function" then dumpFunctionDeep("table." .. key, value, 0) end
                end
                if tableCount >= 160 then break end
            end
        end
    end

    if type(getconstantsFn) == "function" then
        push("")
        push("---- FUNCOES GC COM CONSTANTES RELEVANTES ----")
        local functionCount = 0
        for i, obj in ipairs(objects) do
            if i % 300 == 0 then task.wait() end
            if type(obj) == "function" then
                local okc, constants = pcall(getconstantsFn, obj)
                if okc and constantsMatch(constants) then
                    functionCount += 1
                    dumpFunctionDeep("gc_function_" .. i, obj, 0)
                    if functionCount >= 220 then break end
                end
            end
        end
    end

    push(string.format(
        "Inspecao concluida: callbacks=%d tables=%d functions=%d gc=%d",
        state.callbackCount,
        tableCount,
        state.internalFunctions,
        #objects
    ))
    state.inspecting = false
end

local function nextSession()
    if type(isfileFn) ~= "function" then return 1 end
    for i = 1, 99 do
        local name = string.format("MAM2_RECON_RUNTIME_V3_S%02d.txt", i)
        local exists = false
        pcall(function() exists = isfileFn(name) end)
        if not exists then return i end
    end
    return 99
end

