local function constantsMatch(constants)
    if type(constants) ~= "table" then return false end
    for _, value in pairs(constants) do
        if type(value) == "string" then
            local low = string.lower(value)
            for _, needle in ipairs(NEEDLES) do
                if low:find(string.lower(needle), 1, true) then
                    return true
                end
            end
        end
    end
    return false
end

