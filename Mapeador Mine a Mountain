local function constantsMatch(c)
    if type(c)~="table" then return false end
    for _,v in pairs(c) do
        if type(v)=="string" then
            local low=string.lower(v)
            for _,n in ipairs(NEEDLES) do
                if low:find(string.lower(n),1,true) then return true end
            end
        end
    end
    return false
end

local function dumpFn(label,fn)
    push("")
    push("[FUNCTION] "..clean(label))
    if type(getconstantsFn)=="function" then
        local ok,c=pcall(getconstantsFn,fn)
        if ok and type(c)=="table" then
            local out,n={},0
            for k,v in pairs(c) do
                n+=1
                if n>100 then out[#out+1]="...";break end
                out[#out+1]=tostring(k).."="..ser(v)
            end
            push("  constants: "..table.concat(out," | "))
        end
    end
    if type(getupvaluesFn)=="function" then
        local ok,u=pcall(getupvaluesFn,fn)
        if ok then push("  upvalues: "..ser(u)) end
    end
    pcall(function()
        if debug and debug.info then push("  debug.info: "..tostring(debug.info(fn,"sln"))) end
    end)
end

local function dumpMap(title,map)
    push("")
    push("---- "..title.." ----")
    if type(map)~="table" then push("<nao encontrado>");return end
    local keys={}
    for k in pairs(map) do keys[#keys+1]=tostring(k) end
    table.sort(keys)
    for _,k in ipairs(keys) do
        local o=map[k]
        local v,t
        pcall(function()v=o.Value;t=o.Type end)
        push(string.format("%s | type=%s | value=%s",clean(k),tostring(t or typeof(o)),ser(v)))
    end
end

local function scanRemotes()
    push("")
    push("---- REMOTES VISIVEIS EM ReplicatedStorage ----")
    local n=0
    for _,inst in ipairs(RS:GetDescendants()) do
        if inst:IsA("RemoteEvent") or inst:IsA("RemoteFunction") then
            n+=1
            push(string.format("%03d | %s | %s",n,inst.ClassName,clean(full(inst))))
            if n>=600 then push("<limite de 600 remotes>");break end
        end
    end
    if n==0 then push("<nenhum remote visivel>") end
end

local function inspectInternals()
    if state.inspecting then return end
    state.inspecting=true
    push("")
    push("############################################################")
    push("INSPECAO INTERNA ["..stamp().."]")
    push("############################################################")

    dumpMap("TOGGLES",ENV.Toggles)
    dumpMap("OPTIONS",ENV.Options)
    pcall(scanRemotes)

    if type(getgcFn)~="function" then
        push("getgc indisponivel.")
        state.inspecting=false
        return
    end

    local ok,objects=pcall(getgcFn,true)
    if not ok or type(objects)~="table" then
        push("getgc(true) falhou.")
        state.inspecting=false
        return
    end

    push("")
    push("---- TABELAS CANDIDATAS ----")
    local tc,fc=0,0
    for i,o in ipairs(objects) do
        if i%300==0 then task.wait() end
        if type(o)=="table" then
            local hits={}
            for _,k in ipairs(TARGET_KEYS) do
                if rawget(o,k)~=nil then hits[#hits+1]=k end
            end
            if #hits>=2 then
                tc+=1
                state.internalTables+=1
                push(string.format("[TABLE %03d] gc=%d hits=%s",tc,i,table.concat(hits,", ")))
                for _,k in ipairs(hits) do
                    local v=rawget(o,k)
                    push("  "..k.." = "..ser(v))
                    if type(v)=="function" then dumpFn("table."..k,v) end
                end
                if tc>=70 then push("<limite de tabelas candidatas>");break end
            end
        end
    end

    if type(getconstantsFn)=="function" then
        push("")
        push("---- FUNCOES GC COM CONSTANTES RELEVANTES ----")
        for i,o in ipairs(objects) do
            if i%250==0 then task.wait() end
            if type(o)=="function" then
                local okc,c=pcall(getconstantsFn,o)
                if okc and constantsMatch(c) then
                    fc+=1
                    state.internalFunctions+=1
                    dumpFn("gc_function_"..i,o)
                    if fc>=140 then push("<limite de funcoes candidatas>");break end
                end
            end
        end
    end

    push(string.format("Inspecao concluida: tables=%d functions=%d gc=%d",tc,fc,#objects))
    state.inspecting=false
end

local function nextSession()
    if type(isfileFn)~="function" then return 1 end
    for i=1,99 do
        local n=string.format("MAM2_RECON_RUNTIME_S%02d.txt",i)
        local exists=false
        pcall(function()exists=isfileFn(n)end)
        if not exists then return i end
    end
    return 99
end
local session=nextSession()

local function begin()
    if state.active then return false end
    state.lines={}
    state.remoteCount=0;state.promptCount=0;state.clickCount=0
    state.internalTables=0;state.internalFunctions=0
    state.finalized=false;state.active=true
    push("Mine a Mountain 2 - Runtime Reconstruction Mapper V2")
    push("session="..session)
    push("started_clock="..stamp())
    push("remote_hook_ok="..tostring(remoteHookOK))
    push("getgc="..tostring(type(getgcFn)=="function"))
    push("getconstants="..tostring(type(getconstantsFn)=="function"))
    push("getupvalues="..tostring(type(getupvaluesFn)=="function"))
    mark("GERAL / LOADER")
    return true
end

local function finish()
    if not state.active then return false,"Nenhum mapeamento em andamento." end
    state.active=false
    push("")
    push("############################################################")
    push("FINAL")
    push("############################################################")
    push("finished_clock="..stamp())
    push("remote_calls="..state.remoteCount)
    push("prompt_calls="..state.promptCount)
    push("click_calls="..state.clickCount)
    push("internal_tables="..state.internalTables)
    push("internal_functions="..state.internalFunctions)

    local name=string.format("MAM2_RECON_RUNTIME_S%02d.txt",session)
    local content=table.concat(state.lines,"\n")
    if type(writefileFn)=="function" then
        local ok,e=pcall(writefileFn,name,content)
        if ok then state.finalized=true;return true,name end
        return false,tostring(e)
    end
    if type(setclipboardFn)=="function" then
        pcall(setclipboardFn,content)
        return false,"writefile indisponivel; conteudo copiado."
    end
    return false,"writefile/setclipboard indisponiveis."
end

