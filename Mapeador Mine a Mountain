    listPad.PaddingTop = UDim.new(0, 4)
    listPad.PaddingBottom = UDim.new(0, 4)
    listPad.PaddingLeft = UDim.new(0, 4)
    listPad.PaddingRight = UDim.new(0, 4)
    listPad.Parent = listFrame

    local selected = nil
    local cached = {}
    local open = false

    local function close()
        open = false
        listFrame.Visible = false
        listFrame.Size = UDim2.new(1, 0, 0, 0)
        wrap.Size = UDim2.new(1, 0, 0, 50)
        arrow.Text = "▼"
    end

    local function refresh()
        local ok, values = pcall(getValues)
        if not ok or type(values) ~= "table" then values = {} end

        local same = #values == #cached
        if same then
            for i = 1, #values do
                if tostring(values[i]) ~= tostring(cached[i]) then same = false; break end
            end
        end
        if same then return end

        cached = {}
        for i, v in ipairs(values) do cached[i] = tostring(v) end

        for _, child in ipairs(listFrame:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end

        if #cached == 0 then
            selected = nil
            bar.Text = "  aguardando menu original..."
            close()
            return
        end

        if not selected or not table.find(cached, selected) then selected = cached[1] end
        bar.Text = "  " .. selected

        for _, value in ipairs(cached) do
            local item = Instance.new("TextButton")
            item.Size = UDim2.new(1, 0, 0, 25)
            item.BackgroundColor3 = COLORS.button2
            item.BorderSizePixel = 0
            item.Font = Enum.Font.Gotham
            item.TextSize = 11
            item.TextColor3 = COLORS.text
            item.TextXAlignment = Enum.TextXAlignment.Left
            item.Text = "  " .. value
            item.AutoButtonColor = false
            item.Parent = listFrame
            corner(item, 5)

            item.Activated:Connect(function()
                selected = value
                bar.Text = "  " .. value
                close()
            end)
        end
    end

    bar.Activated:Connect(function()
        refresh()
        if #cached == 0 then return end
        open = not open
        listFrame.Visible = open
        arrow.Text = open and "▲" or "▼"
        if open then
            local height = math.clamp(#cached * 28 + 8, 36, 190)
            listFrame.Size = UDim2.new(1, 0, 0, height)
            wrap.Size = UDim2.new(1, 0, 0, 53 + height)
        else
            close()
        end
    end)

    state.dropdownRefreshers[#state.dropdownRefreshers + 1] = refresh
    refresh()

    return {
        Refresh = refresh,
        GetValue = function() return selected end,
    }
end

