end

-- RemoteEvent / RemoteFunction
local remoteHookOK=false
if type(hookmetamethodFn)=="function" and type(getnamecallmethodFn)=="function" then
    local old
    local handler
    handler=function(self,...)
        local method
        pcall(function()method=getnamecallmethodFn()end)
        local cap=state.active and state.remoteCount<state.maxRemoteEvents
            and (method=="FireServer" or method=="InvokeServer")
        local isRemote=false
        if cap and typeof(self)=="Instance" then
            pcall(function()isRemote=self:IsA("RemoteEvent") or self:IsA("RemoteFunction")end)
        end
        if cap and isRemote then
            state.remoteCount+=1
            push(string.format(
                "[REMOTE %04d][%s][%s] %s:%s(%s)",
                state.remoteCount,stamp(),state.marker,clean(full(self)),tostring(method),args(...)
            ))
        end
        if method=="InvokeServer" then
            local r=table.pack(old(self,...))
            if cap and isRemote then
                local out={}
                for i=1,r.n do out[i]=ser(r[i]) end
                push("[RETURN]["..state.marker.."] "..table.concat(out,", "))
            end
            return table.unpack(r,1,r.n)
        end
        return old(self,...)
    end
    if type(newcclosureFn)=="function" then handler=newcclosureFn(handler) end
    local ok,res=pcall(function()
        old=hookmetamethodFn(game,"__namecall",handler)
        return old
    end)
    remoteHookOK=ok and type(res)=="function"
end

