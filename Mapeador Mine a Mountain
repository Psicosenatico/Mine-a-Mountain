local function push(value)
    if #state.lines < state.maxLines then
        state.lines[#state.lines + 1] = tostring(value)
    end
end

local function stamp()
    return string.format("%.3f", os.clock())
end

local function sensitive(value)
    local s = string.lower(tostring(value or ""))
    return s:find("authorization", 1, true)
        or s:find("bearer ", 1, true)
        or s:find("license", 1, true)
        or s:find("premium_key", 1, true)
        or s:find("api_key", 1, true)
        or s:find("session_token", 1, true)
        or s:find("access_token", 1, true)
        or s:find("key=", 1, true)
end

local function clean(value)
    local s = tostring(value or "")
    if sensitive(s) then
        return "<REDACTED_SENSITIVE_STRING>"
    end
    if #s > 260 then
        return string.format("<LONG_STRING len=%d prefix=%q>", #s, s:sub(1, 80))
    end
    return s
end

local function full(inst)
    local ok, result = pcall(function() return inst:GetFullName() end)
    return ok and result or tostring(inst)
end

local function ser(value, depth, seen)
    depth = depth or 0
    seen = seen or {}
    if depth > 4 then return "<max-depth>" end

    local t = typeof(value)
    if t == "nil" then return "nil" end
    if t == "boolean" or t == "number" then return tostring(value) end
    if t == "string" then return string.format("%q", clean(value)) end
    if t == "Instance" then
        return string.format("<%s %s | %s>", value.ClassName, clean(value.Name), clean(full(value)))
    end
    if t == "Vector3" then
        return string.format("Vector3(%.3f,%.3f,%.3f)", value.X, value.Y, value.Z)
    end
    if t == "Vector2" then
        return string.format("Vector2(%.3f,%.3f)", value.X, value.Y)
    end
    if t == "CFrame" then
        local c = { value:GetComponents() }
        for i = 1, #c do c[i] = string.format("%.4f", c[i]) end
        return "CFrame(" .. table.concat(c, ",") .. ")"
    end
    if t == "Color3" then
        return string.format("Color3(%.3f,%.3f,%.3f)", value.R, value.G, value.B)
    end
    if t == "EnumItem" then return tostring(value) end
    if t == "function" then return "<function>" end

    if t == "table" then
        if seen[value] then return "<cycle>" end
        seen[value] = true
        local out, count = {}, 0
        for k, v in pairs(value) do
            count += 1
            if count > 40 then
                out[#out + 1] = "..."
                break
            end
            out[#out + 1] = "[" .. ser(k, depth + 1, seen) .. "]=" .. ser(v, depth + 1, seen)
        end
        seen[value] = nil
        return "{" .. table.concat(out, ", ") .. "}"
    end

    return "<" .. t .. ":" .. clean(tostring(value)) .. ">"
end

local function args(...)
    local packed = table.pack(...)
    local out = {}
    for i = 1, packed.n do
        out[i] = ser(packed[i])
    end
    return table.concat(out, ", ")
end

local function getControlMap(kind)
    if kind == "TOGGLE" then return ENV.Toggles end
    return ENV.Options
end

local function getControl(kind, key)
    local map = getControlMap(kind)
    if type(map) ~= "table" then return nil end
    return rawget(map, key)
end

local function readControlValue(obj)
    if type(obj) ~= "table" then return nil end
    local value
    pcall(function() value = obj.Value end)
    return value
end

local function normalizeValueForDiff(value)
    local t = typeof(value)
    if t ~= "table" then return ser(value) end
    local arr = {}
    for k, v in pairs(value) do
        if v == true then arr[#arr + 1] = tostring(k)
        else arr[#arr + 1] = tostring(k) .. "=" .. ser(v) end
    end
    table.sort(arr)
    return "{" .. table.concat(arr, ",") .. "}"
end

local function controlType(obj)
    if type(obj) ~= "table" then return "nil" end
    local typ
    pcall(function() typ = obj.Type end)
    return tostring(typ or typeof(obj))
end

local function getOptionValues(key)
    local obj = getControl("OPTION", key)
    if type(obj) ~= "table" then return {} end
    local values
    pcall(function() values = obj.Values end)
    if type(values) ~= "table" then return {} end

    local out = {}
    for _, v in ipairs(values) do
        out[#out + 1] = tostring(v)
    end
    if #out == 0 then
        for k, v in pairs(values) do
            if type(k) == "number" then
                out[#out + 1] = tostring(v)
            else
                out[#out + 1] = tostring(k)
            end
        end
    end
    table.sort(out)
    return out
end

local function snapshotControls(tag, keys)
    push("")
    push("---- SNAPSHOT " .. clean(tag) .. " [" .. stamp() .. "] ----")

    local toggles, options = ENV.Toggles, ENV.Options

    if type(keys) == "table" and #keys > 0 then
        for _, spec in ipairs(keys) do
            local kind, key = spec[1], spec[2]
            local obj = getControl(kind, key)
            if obj then
                push(string.format(
                    "%s %s | type=%s | value=%s",
                    kind,
                    clean(key),
                    controlType(obj),
                    normalizeValueForDiff(readControlValue(obj))
                ))
            else
                push(string.format("%s %s | <nao encontrado>", kind, clean(key)))
            end
        end
        return
    end

    if type(toggles) == "table" then
        local names = {}
        for k in pairs(toggles) do names[#names + 1] = tostring(k) end
        table.sort(names)
        for _, key in ipairs(names) do
            local obj = toggles[key]
            push(string.format(
                "TOGGLE %s | type=%s | value=%s",
                clean(key),
                controlType(obj),
                normalizeValueForDiff(readControlValue(obj))
            ))
        end
    end

    if type(options) == "table" then
        local names = {}
        for k in pairs(options) do names[#names + 1] = tostring(k) end
        table.sort(names)
        for _, key in ipairs(names) do
            local obj = options[key]
            push(string.format(
                "OPTION %s | type=%s | value=%s",
                clean(key),
                controlType(obj),
                normalizeValueForDiff(readControlValue(obj))
            ))
        end
    end
end

local function mark(name, keys)
    state.markerId += 1
    state.marker = name
    push("")
    push("================================================================")
    push(string.format("MARKER #%03d [%s] %s", state.markerId, stamp(), clean(name)))
    push("================================================================")
    if keys then snapshotControls("INICIO " .. name, keys) end
end

local remoteHookOK = false
if type(hookmetamethodFn) == "function" and type(getnamecallmethodFn) == "function" then
    local old
    local handler

    handler = function(self, ...)
        local method
        pcall(function() method = getnamecallmethodFn() end)

        local cap = state.active
            and state.remoteCount < state.maxRemoteEvents
            and (method == "FireServer" or method == "InvokeServer")

        local isRemote = false
        if cap and typeof(self) == "Instance" then
            pcall(function()
                isRemote = self:IsA("RemoteEvent") or self:IsA("RemoteFunction")
            end)
        end

        if cap and isRemote then
            state.remoteCount += 1
            push(string.format(
                "[REMOTE %05d][%s][M%03d:%s] %s:%s(%s)",
                state.remoteCount,
                stamp(),
                state.markerId,
                clean(state.marker),
                clean(full(self)),
                tostring(method),
                args(...)
            ))
        end

        if method == "InvokeServer" then
            local result = table.pack(old(self, ...))
            if cap and isRemote then
                local out = {}
                for i = 1, result.n do out[i] = ser(result[i]) end
                push("[RETURN][" .. clean(state.marker) .. "] " .. table.concat(out, ", "))
            end
            return table.unpack(result, 1, result.n)
        end

        return old(self, ...)
    end

    if type(newcclosureFn) == "function" then
        handler = newcclosureFn(handler)
    end

    local ok, result = pcall(function()
        old = hookmetamethodFn(game, "__namecall", handler)
        return old
    end)
    remoteHookOK = ok and type(result) == "function"
end

