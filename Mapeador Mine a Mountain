    makeToggleMapper(money, "Colocar Fortune Rune", "MoneyPlaceFortuneRune", "MONEY / PLACE FORTUNE")
    makeToggleMapper(money, "Remover Fortune Rune", "MoneyForceRemoveFortuneRune", "MONEY / REMOVE FORTUNE")
