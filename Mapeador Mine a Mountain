    makeCurrentValueMapper(placement, "Altura", "OPTION", "PlacementHeight", "PLACE / HEIGHT")
    makeCurrentValueMapper(placement, "Runas por vez", "OPTION", "RunePlaceAtOnce", "PLACE / RUNES AT ONCE")
    makeCurrentValueMapper(placement, "Intervalo de Runas", "OPTION", "RunePlaceInterval", "PLACE / RUNE INTERVAL")

    local partial = section(scroll, "Player / Visuais que ainda precisam de binding")
    makeToggleMapper(partial, "No Ragdoll", "misc_no_ragdoll", "PLAYER / NO RAGDOLL")
    makeToggleMapper(partial, "No Camera Shake", "misc_no_camera_shake", "PLAYER / NO CAMERA SHAKE")
    makeToggleMapper(partial, "Optimize Crystals", "misc_optimize_crystals", "VISUAL / OPTIMIZE CRYSTALS")
    makeToggleMapper(partial, "No Fall Damage", "misc_no_fall_damage", "PLAYER / NO FALL DAMAGE")
    makeToggleMapper(partial, "God Mode", "misc_god_mode", "PLAYER / GOD MODE")

    local generic = section(scroll, "Navegador genérico de qualquer controle")
    local kindDD = makeDropdown(generic, "Tipo de controle", function() return {"OPTION", "TOGGLE"} end)
    local keyDD = makeDropdown(generic, "Controle", function()
        local kind = kindDD.GetValue() or "OPTION"
        local map = getControlMap(kind)
        local out = {}
        if type(map) == "table" then
            for key in pairs(map) do out[#out + 1] = tostring(key) end
            table.sort(out)
        end
        return out
    end)
    local valueDD = makeDropdown(generic, "Valor disponível (quando houver)", function()
        local kind = kindDD.GetValue()
        local key = keyDD.GetValue()
        if kind == "OPTION" and key then return getOptionValues(key) end
        return {}
    end)

    local genericInspect = button(generic, "Marcar + inspecionar controle", 30)
    genericInspect.Activated:Connect(function()
        if not state.active then return end
        local kind, key = kindDD.GetValue(), keyDD.GetValue()
        if not kind or not key then return end
        mark("GENERIC / " .. kind .. " / " .. key, targetControlSnapshot(kind, key))
        pcall(inspectControl, kind, key, true)
    end)

    local genericApply = button(generic, "Aplicar valor selecionado + mapear", 30)
    genericApply.Activated:Connect(function()
        if not state.active then return end
        local kind, key = kindDD.GetValue(), keyDD.GetValue()
        if not kind or not key then return end
        if kind == "TOGGLE" then
            local obj = getControl(kind, key)
            if not obj then return end
            local after = not (readControlValue(obj) == true)
            mark("GENERIC / TOGGLE / " .. key .. "=" .. tostring(after), targetControlSnapshot(kind, key))
            pcall(inspectControl, kind, key, true)
            setToggleValue(key, after)
        else
            local selected = valueDD.GetValue()
            if selected then
                mark("GENERIC / OPTION / " .. key .. "=" .. selected, targetControlSnapshot(kind, key))
                pcall(inspectControl, kind, key, true)
                setOptionValue(key, selected, true)
            else
                mark("GENERIC / OPTION / " .. key .. " / CURRENT", targetControlSnapshot(kind, key))
                pcall(inspectControl, kind, key, true)
            end
        end
    end)

    local finalSection = section(scroll, "Finalização")
    local inspectButton = button(finalSection, "Inspecionar bindings / callbacks", 32)
    local saveButton = button(finalSection, "Finalizar e salvar arquivo", 32)

    inspectButton.Activated:Connect(function()
        if not state.active or state.inspecting then return end
        status.Text = "Status: INSPECIONANDO BINDINGS..."
        task.spawn(function()
            local ok, err = pcall(inspectInternals)
            if not ok then push("ERRO INSPECAO: " .. clean(err)) end
            if state.active then status.Text = "Status: MAPEANDO | inspeção concluída" end
        end)
    end)

    saveButton.Activated:Connect(function()
        if state.inspecting then status.Text = "Status: aguarde a inspeção terminar"; return end
        local ok, result = finish()
        if ok then
            status.Text = "Status: FINALIZADO E SALVO"
            saveButton.Text = "Arquivo salvo: " .. tostring(result)
        else
            status.Text = "Status: " .. tostring(result)
        end
    end)

    task.spawn(function()
        while gui.Parent do
            counter.Text = string.format(
                "Remote %d | Mudanças %d | Bindings %d",
                state.remoteCount,
                state.controlChangeCount,
                state.callbackCount
            )
            task.wait(0.25)
        end
    end)

    do
        local dragging, dragInput, dragStart, startPos = false, nil, nil, nil
        header.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = frame.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End or input.UserInputState == Enum.UserInputState.Cancel then dragging = false end
                end)
            end
        end)
        header.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
        end)
        UIS.InputChanged:Connect(function(input)
            if dragging and input == dragInput then
                local delta = input.Position - dragStart
                frame.Position = UDim2.new(
                    startPos.X.Scale,
                    startPos.X.Offset + delta.X,
                    startPos.Y.Scale,
                    startPos.Y.Offset + delta.Y
                )
            end
        end)
    end
end

