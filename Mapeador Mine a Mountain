        task.spawn(function()
            local ok,e=pcall(inspectInternals)
            if not ok then push("ERRO INSPECAO: "..clean(e)) end
            if state.active then status.Text="Status: MAPEANDO | internos concluidos" end
        end)
    end)
    save.Activated:Connect(function()
        if state.inspecting then status.Text="Status: aguarde a inspecao terminar";return end
        local ok,r=finish()
        if ok then status.Text="Status: FINALIZADO E SALVO";save.Text="Arquivo salvo"
        else status.Text="Status: "..tostring(r) end
    end)

    task.spawn(function()
        while gui.Parent do
            counter.Text=string.format("Remote: %d | Prompt: %d | Internos: %d",
                state.remoteCount,state.promptCount,state.internalTables+state.internalFunctions)
            task.wait(.25)
        end
    end)

    local dragging,dragInput,dragStart,startPos=false,nil,nil,nil
    header.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
            dragging=true;dragStart=i.Position;startPos=frame.Position
            i.Changed:Connect(function()
                if i.UserInputState==Enum.UserInputState.End or i.UserInputState==Enum.UserInputState.Cancel then dragging=false end
            end)
        end
    end)
    header.InputChanged:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch then dragInput=i end
    end)
    UIS.InputChanged:Connect(function(i)
        if dragging and i==dragInput then
            local d=i.Position-dragStart
            frame.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+d.X,startPos.Y.Scale,startPos.Y.Offset+d.Y)
        end
    end)
end

