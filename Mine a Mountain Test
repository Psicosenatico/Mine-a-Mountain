-- Mine a Mountain 2 — Standalone Reconstruction V3 PT-BR
-- Entrada principal. A fonte completa está dividida em blocos no mesmo repositório
-- para preservar integralmente o código durante a gravação pelo conector.
-- Os blocos 01-08 contêm a interface/funções reconstruídas; o bloco 09 aplica a
-- camada final de tradução visual sem alterar IDs internos nem bindings.

local BASE = "https://raw.githubusercontent.com/Psicosenatico/Mine-a-Mountain/main/mam2_v3_parts/"
local EXPECTED = {9472, 9489, 9469, 9481, 9497, 9500, 9487, 8463, 4323}
local TOTAL_EXPECTED = 79181

local parts = table.create(#EXPECTED)

for i, expectedBytes in ipairs(EXPECTED) do
    local url = BASE .. string.format("part%02d.txt", i)
    local ok, body = pcall(function()
        return game:HttpGet(url)
    end)

    if not ok or type(body) ~= "string" then
        error(string.format("MAM2 V3: falha ao carregar o bloco %02d", i))
    end

    if #body ~= expectedBytes then
        error(string.format(
            "MAM2 V3: bloco %02d incompleto (%d/%d bytes)",
            i, #body, expectedBytes
        ))
    end

    parts[i] = body
end

local SOURCE = table.concat(parts)

if #SOURCE ~= TOTAL_EXPECTED then
    error(string.format(
        "MAM2 V3: fonte incompleta (%d/%d bytes)",
        #SOURCE, TOTAL_EXPECTED
    ))
end

local fn, err = loadstring(SOURCE)
if not fn then
    error("MAM2 V3: erro ao compilar a fonte reconstruída: " .. tostring(err))
end

return fn()
