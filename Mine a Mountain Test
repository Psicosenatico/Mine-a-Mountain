    return h
end

local function crystalTitle(x)
    local parent = x.Parent
    local name = getAttr(x, "CrystalName")
        or (parent and getAttr(parent, "CrystalName"))
        or x.Name
    local tier = getAttr(x, "TierName") or (parent and getAttr(parent, "TierName"))
    local value = tonumber(getAttr(x, "Value") or (parent and getAttr(parent, "Value")))
    local weight = tonumber(getAttr(x, "WeightKg") or (parent and getAttr(parent, "WeightKg")))
    local luck = getAttr(x, "LuckBoost") or (parent and getAttr(parent, "LuckBoost"))

    local meta = {}
    if tier then meta[#meta+1] = tostring(tier) end
    if value then meta[#meta+1] = "$" .. tostring(math.floor(value)) end
    if weight then meta[#meta+1] = string.format("%.1fkg", weight) end
    if luck then meta[#meta+1] = tostring(luck) end

    return tostring(name), table.concat(meta, "  •  ")
end

local espClock = 0
track(RunService.Heartbeat:Connect(function(dt)
    if S.Destroyed then return end
    espClock += dt
    if espClock < 0.35 then return end
    espClock = 0

    local r = root()

    if not S.PlayerESP then
        clearMap(S.PlayerEsp)
    else
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP then
                local c = p.Character
                local pr = c and c:FindFirstChild("HumanoidRootPart")
                local ph = c and c:FindFirstChildOfClass("Humanoid")
                if pr and ph and ph.Health > 0 then
                    local e = S.PlayerEsp[p]
                    if not e or not e.gui or not e.gui.Parent then
                        local g, l = makeBillboard(pr, "__MAM2_PlayerESP", Color3.new(1,1,1))
                        e = {gui=g, label=l}
                        S.PlayerEsp[p] = e
                    end
                    e.gui.Adornee = pr
                    local d = r and (r.Position - pr.Position).Magnitude or 0
                    e.label.Text = string.format("%s\n%.0f studs", p.DisplayName or p.Name, d)
                elseif S.PlayerEsp[p] then
                    pcall(function() S.PlayerEsp[p].gui:Destroy() end)
                    S.PlayerEsp[p] = nil
                end
            end
        end
    end

    if not r then return end

    local op = OverlapParams.new()
    op.FilterType = Enum.RaycastFilterType.Exclude
    op.FilterDescendantsInstances = {char()}

    if not S.UniverseESP then
        clearMap(S.UniverseEsp)
    else
        local ok, parts = pcall(
            Workspace.GetPartBoundsInRadius,
            Workspace,
            r.Position,
            S.UniverseEspRange,
            op
        )
        if ok then
            local seen = {}
            for _, p in ipairs(parts) do
                local x = crystalPart(p)
                if x then
                    seen[x] = true
                    local e = S.UniverseEsp[x]
                    if not e then
                        local target = x.Parent and x.Parent:IsA("Model") and x.Parent or x
                        local hi = makeHighlight(target, "UniverseHighlight", Color3.fromRGB(0,170,255))
                        local g, l = makeBillboard(x, "UniverseEsp", Color3.fromRGB(235,245,255))
                        e = {highlight=hi, gui=g, label=l}
                        S.UniverseEsp[x] = e
                    end
                    local n, meta = crystalTitle(x)
                    local d = (r.Position - x.Position).Magnitude
                    e.label.Text = n .. "\n" .. meta .. string.format("  •  %.0fm", d)
                end
            end
            for x, e in pairs(S.UniverseEsp) do
                if not x.Parent or not seen[x] then
                    pcall(function() e.highlight:Destroy(); e.gui:Destroy() end)
                    S.UniverseEsp[x] = nil
                end
            end
        end
    end

    if not S.RuneESP and not S.RuneTracers then
        clearMap(S.RuneEsp)
        clearMap(S.RuneTracersMap)
    else
        local ok, parts = pcall(
            Workspace.GetPartBoundsInRadius,
            Workspace,
            r.Position,
            S.RuneEspRange,
            op
        )
        if ok then
            local seen = {}
            for _, p in ipairs(parts) do
                if isRune(p) then
                    seen[p] = true
                    if S.RuneESP and not S.RuneEsp[p] then
                        local target = p.Parent and p.Parent:IsA("Model") and p.Parent or p
                        S.RuneEsp[p] = makeHighlight(
                            target,
                            "UniverseRuneHighlight",
                            Color3.fromRGB(255,215,80)
                        )
                    end
                    if S.RuneTracers and not S.RuneTracersMap[p] then
                        local a0 = Instance.new("Attachment")
                        a0.Name = "__MAM2_RuneTrace0"
                        a0.Parent = r
                        local a1 = Instance.new("Attachment")
                        a1.Name = "__MAM2_RuneTrace1"
                        a1.Parent = p
                        local beam = Instance.new("Beam")
                        beam.Name = "__MAM2_RuneTracer"
                        beam.Attachment0 = a0
                        beam.Attachment1 = a1
                        beam.FaceCamera = true
                        beam.Width0 = 0.035
                        beam.Width1 = 0.035
                        beam.Color = ColorSequence.new(Color3.fromRGB(255,215,80))
                        beam.Transparency = NumberSequence.new(0.15)
                        beam.Parent = r
                        S.RuneTracersMap[p] = {a0=a0,a1=a1,beam=beam}
                    end
                end
            end
            for p, h in pairs(S.RuneEsp) do
                if not S.RuneESP or not p.Parent or not seen[p] then
                    pcall(function() h:Destroy() end)
                    S.RuneEsp[p] = nil
                end
            end
            for p, e in pairs(S.RuneTracersMap) do
                if not S.RuneTracers or not p.Parent or not seen[p] then
                    pcall(function() e.beam:Destroy();e.a0:Destroy();e.a1:Destroy() end)
                    S.RuneTracersMap[p] = nil
                end
            end
        end
    end
end))

