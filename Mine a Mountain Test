local function clearMap(map)
    for k, v in pairs(map) do
        pcall(function()
            if type(v) == "table" then
                for _, o in pairs(v) do
                    if typeof(o) == "Instance" then o:Destroy() end
                end
            elseif typeof(v) == "Instance" then
                v:Destroy()
            end
        end)
        map[k] = nil
    end
end

