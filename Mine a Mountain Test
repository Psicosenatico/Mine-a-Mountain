local function isCrystal(p)
 if not p or not p:IsA("BasePart") then return false end
 local v=p:GetAttribute("Value") or (p.Parent and p.Parent:GetAttribute("Value"))
 if v==nil then return false end
 local n=p:GetAttribute("CrystalName") or (p.Parent and p.Parent:GetAttribute("CrystalName"))
 return n~=nil or p.Name:lower():find("crystal",1,true)~=nil
end
local function crystalPart(p)
 if isCrystal(p) then return p end
 local m=p and p.Parent
 if m and m:IsA("Model") then for _,d in ipairs(m:GetDescendants()) do if d:IsA("BasePart") and isCrystal(d) then return d end end end
end
local function isRune(p)
 if not p or not p:IsA("BasePart") then return false end
 if p.Name:lower():find("rune",1,true) then return true end
 if p.Parent and p.Parent.Name:lower():find("rune",1,true) then return true end
 return p:GetAttribute("TierName")~=nil and p:GetAttribute("LuckBoost")~=nil
end
local function promptOf(x)
 if not x then return end
 return x:FindFirstChildWhichIsA("ProximityPrompt",true) or (x.Parent and x.Parent:FindFirstChildWhichIsA("ProximityPrompt",true))
end
local function clickOf(x)
 if not x then return end
 return x:FindFirstChildWhichIsA("ClickDetector",true) or (x.Parent and x.Parent:FindFirstChildWhichIsA("ClickDetector",true))
end
local function grabLocal(x)
 local p=promptOf(x)
 if p and type(fireproximityprompt)=="function" then local ok=pcall(fireproximityprompt,p) if ok then return true end end
 local c=clickOf(x)
 if c and type(fireclickdetector)=="function" then local ok=pcall(fireclickdetector,c) if ok then return true end end
 return false
end

-- Confirmed/partially reconstructed player protection.
local function safety()
 if S.Destroyed then return end
 local c,h,r=char(),hum(),root(); if not c or not h or not r then return end
