-- Mine a Mountain 2 — Standalone Reconstruction V3 PT-BR
-- Entrada principal da reconstrução visual.
-- Carrega os blocos da fonte e aplica correções estruturais antes da compilação.

local StarterGui = game:GetService("StarterGui")

local function reportError(message)
    warn("[MAM2 V3] " .. tostring(message))
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "MAM2 V3 - Erro de inicialização",
            Text = tostring(message),
            Duration = 10,
        })
    end)
end

local BASE = "https://raw.githubusercontent.com/Psicosenatico/Mine-a-Mountain/main/mam2_v3_parts/"
local PART_COUNT = 9
local parts = table.create(PART_COUNT)

for i = 1, PART_COUNT do
    local url = BASE .. string.format("part%02d.txt", i)
    local ok, body = pcall(function()
        return game:HttpGet(url)
    end)

    if not ok or type(body) ~= "string" or #body < 256 then
        local msg = string.format("Falha ao carregar o bloco %02d.", i)
        reportError(msg)
        error("MAM2 V3: " .. msg)
    end

    parts[i] = body
end

local SOURCE = table.concat(parts)

-- Validação estrutural por marcadores, sem depender de tamanho exato dos arquivos.
local REQUIRED = {
    "local Players = game:GetService(\"Players\")",
    "local rail = Instance.new(\"Frame\")",
    "local function destroy()",
    "Tradução PT-BR completa aplicada à interface.",
}

for _, marker in ipairs(REQUIRED) do
    if not SOURCE:find(marker, 1, true) then
        local msg = "Fonte reconstruída incompleta: marcador ausente."
        reportError(msg)
        error("MAM2 V3: " .. msg)
    end
end

-- Correção de fidelidade visual:
-- Na biblioteca original, o TabRail é filho direto da janela externa (Outer),
-- não da área interna de conteúdo. Como 'inner' começa 8 px para dentro,
-- manter o rail dentro dele fazia seu limite direito invadir o painel.
local railPatchCount
do
    local patched
    patched, railPatchCount = SOURCE:gsub(
        "rail%.Parent = inner",
        "rail.Parent = main",
        1
    )
    SOURCE = patched
end

if railPatchCount ~= 1 then
    local msg = "Não foi possível aplicar a correção de posição das abas laterais."
    reportError(msg)
    error("MAM2 V3: " .. msg)
end

-- Centraliza as células dentro da largura do trilho, como na biblioteca original.
SOURCE = SOURCE:gsub(
    "grid%.FillDirectionMaxCells = RAIL_ROWS\ngrid%.SortOrder",
    "grid.FillDirectionMaxCells = RAIL_ROWS\ngrid.HorizontalAlignment = Enum.HorizontalAlignment.Center\ngrid.SortOrder",
    1
)

local fn, compileError = loadstring(SOURCE)
if not fn then
    local msg = "Erro ao compilar a fonte reconstruída: " .. tostring(compileError)
    reportError(msg)
    error("MAM2 V3: " .. msg)
end

local ok, runtimeError = pcall(fn)
if not ok then
    local msg = "Erro durante a inicialização da interface: " .. tostring(runtimeError)
    reportError(msg)
    error("MAM2 V3: " .. msg)
end

return true
