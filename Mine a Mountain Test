  pcall(function() h.PlatformStand=false;h.WalkSpeed=16;h.JumpPower=50;h.RequiresNeck=true;h:ChangeState(Enum.HumanoidStateType.GettingUp) end)
 end
 if S.NoFallDamage then
  pcall(function() if LP:GetAttribute("NoFallDamage")~=true then LP:SetAttribute("NoFallDamage",true) end end)
  if h.FloorMaterial==Enum.Material.Air then local v=r.AssemblyLinearVelocity;if v.Y < -70 then r.AssemblyLinearVelocity=Vector3.new(v.X,-70,v.Z) end end
